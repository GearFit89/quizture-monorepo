{
  "name": "Bible-Quizzing-App",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "expo": "npm run start --workspace=apps/expo-app",
    "android": "npm run android --workspace=apps/expo-app",
    "ios": "npm run ios --workspace=apps/expo-app",
    "web": "npm run web --workspace=apps/expo-app",
    "server": "npm run dev --workspace=apps/server",
    "server:web": "concurrently \"npm run web\" \"npm run server\"",
    "test": "npm run test:run",
    "test:run": "npm run test:run --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:web": "npm run build:web --workspace=apps/expo-app",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "overrides": {
    "react-native-worklets": "0.10.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "concurrently": "^10.0.3",
    "eslint": "~10.13.0",
    "eslint-plugin-hono": "~1.0.6",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-unused-imports": "~4.4.1",
    "neostandard": "^0.14.1",
    "pino-pretty": "^13.1.3"
  },
  "dependencies": {
    "semver": "^7.6.3"
  }
}
