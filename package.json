{
  "name": "Bible-Quizzing-App",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "expo": "npm run start --workspace=apps/expo-app",
    "android": "npm run android --workspace=apps/expo-app",
    "ios": "npm run ios --workspace=apps/expo-app",
    "web": "npm run web --workspace=apps/expo-app",
    "server": "npm run dev --workspace=apps/server",
    "server:web": "concurrently \"npm run web\" \"npm run server\"",
    "test:server": "npm run test --workspace=apps/server",
    "test": "npm run test:run --workspace=apps/server",
    "lint": "npx eslint"
  },
  "overrides": {
    "react-native-worklets": "0.10.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.5",
    "neostandard": "^0.13.0",
    "pino-pretty": "^13.1.3"
  },
  "dependencies": {
    "semver": "^7.6.3"
  }
}
